# Google GenAI / LangChain ChatGoogleGenerativeAI Configuration
# Supports both Gemini Enterprise Agent Platform (Vertex AI) and Gemini Developer API
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: For Gemini Developer API (if GOOGLE_GENAI_USE_VERTEXAI=false)
# GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Model selection (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Required URL Query-String Authentication Key for Streamlit App
# Access via: http://localhost:8501/?apikey=YOUR_API_KEY
API_KEY=replace_with_your_secure_api_key
